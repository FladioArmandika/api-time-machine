---
// The front-page chart: all breaking changes per month across every API, since the month all of them had a public spec.
import { apis, heroSeries, monthLong, monthShort, plural } from "../lib/data";

const { start, cols, peak, top } = heroSeries();
const summary = `Breaking changes per month across all ${apis.length} APIs since ${monthLong(start)}. Peak: ${monthLong(peak.m)} with ${peak.total}.`;
---

<figure class="hero-chart" aria-label={summary}>
  <div class="bars" style={`--n:${cols.length}`} aria-hidden="true">
    {
      cols.map((c) => (
        <div class:list={["col", { partial: c.partial, peak: c === peak }]}>
          {c === peak && <span class="val num">{c.total}</span>}
          <div class="stack" style={`height:${(c.total / top) * 100}%`}>
            {c.segs.map((s) => (
              <span
                class="seg"
                style={`flex-grow:${s.n}`}
                data-tip={`${s.api.name}, ${monthLong(c.m)}${c.partial ? " so far" : ""}: ${plural(s.n, "breaking change")}`}
              />
            ))}
          </div>
        </div>
      ))
    }
  </div>
  <div class="labels" style={`--n:${cols.length}`} aria-hidden="true">
    {
      cols.map((c) =>
        c.partial ? (
          <span class="now">{monthShort(c.m)}, {c.total} so far</span>
        ) : (
          <span>{c.m.endsWith("-01") ? c.m.slice(0, 4) : ""}</span>
        ),
      )
    }
  </div>
  <figcaption>
    Breaking changes per month, all {apis.length} APIs stacked, largest contributor at the base. Hover a bar to see who.
  </figcaption>
</figure>

<style>
  .hero-chart {
    margin: 0;
  }

  .bars,
  .labels {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    column-gap: clamp(2px, 0.35vw, 6px);
  }

  .bars {
    height: clamp(14rem, 38vh, 24rem);
    align-items: end;
    border-bottom: 1px solid var(--ink);
  }

  .col {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    position: relative;
  }

  .stack {
    display: flex;
    flex-direction: column-reverse;
  }

  .seg {
    flex-basis: 0;
    min-height: 1px;
    background: var(--red);
  }

  /* A hairline of page colour between APIs, so each segment can be hovered on its own. */
  .seg + .seg {
    border-bottom: 1px solid var(--bg);
  }

  .seg:hover {
    background: var(--ink);
  }

  .partial .seg {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--red);
  }

  .partial .seg + .seg {
    border-bottom: 0;
  }

  .val {
    position: absolute;
    bottom: calc(100% + 0.25rem);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: var(--t-1);
    font-weight: 600;
    color: var(--ink);
  }

  .col .val {
    position: static;
    transform: none;
    text-align: center;
    margin-bottom: 0.3rem;
  }

  /* Right-aligned flex so the label overflows leftward, never past the page edge. */
  .labels .now {
    display: flex;
    justify-content: flex-end;
  }

  .labels {
    margin-top: 0.4rem;
    font-size: var(--t-1);
    color: var(--ink-3);
  }

  .labels span {
    white-space: nowrap;
    overflow: visible;
  }

  figcaption {
    margin-top: 1rem;
    font-size: var(--t-1);
    color: var(--ink-3);
  }
</style>
