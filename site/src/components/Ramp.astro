---
// Legend for the stripe colours.
import { BINS } from "../lib/data";

interface Props {
  gap?: boolean;
}
const { gap = true } = Astro.props;
---

<div class="ramp">
  <span class="cap">Breaking changes in a month</span>
  <ol>
    <li><span class="key calm"></span>None</li>
    {BINS.map((b) => <li><span class:list={["key", b.bin]}></span>{b.label}</li>)}
    {gap && <li><span class="key gap"></span>No readable spec</li>}
  </ol>
</div>

<style>
  .ramp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: var(--t-1);
    color: var(--ink-2);
  }

  .cap {
    color: var(--ink-3);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  .key {
    width: 0.75rem;
    height: 1rem;
    background: var(--calm);
  }

  .b0 { background: var(--s1); }
  .b1 { background: var(--s2); }
  .b2 { background: var(--s3); }
  .b3 { background: var(--s4); }
  .b4 { background: var(--s5); }

  .gap {
    background: repeating-linear-gradient(135deg, var(--rule) 0 2px, transparent 2px 5px);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
</style>
