---
// The last 12 months as 12 small bars of breaking changes, on a square-root scale shared by every row.
import { cellLabel, last12Months, monthCells, type ApiData } from "../lib/data";

interface Props {
  api: ApiData;
  max: number;
}
const { api, max } = Astro.props;
const cells = monthCells(api, last12Months);
const h = (n: number) => (n > 0 ? Math.max(14, Math.sqrt(n / max) * 100) : 0);
---

<span class="spark" aria-hidden="true">
  {
    cells.map((c) => (
      <span class:list={["m", c.state]} data-tip={`${api.name}, ${cellLabel(c)}`}>
        {c.hard > 0 && <span class="bar" style={`height:${h(c.hard)}%`} />}
      </span>
    ))
  }
</span>

<style>
  .spark {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 3px;
    height: 2.25rem;
    align-items: end;
  }

  .m {
    height: 100%;
    display: flex;
    align-items: flex-end;
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    width: 100%;
    background: var(--red);
  }

  .gap {
    background: repeating-linear-gradient(135deg, var(--rule) 0 2px, transparent 2px 5px);
  }
</style>
