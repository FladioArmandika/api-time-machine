---
// One API's history as a band of month stripes, darker for months that broke more.
import { binOf, cellLabel, monthCells, type ApiData } from "../lib/data";

interface Props {
  api: ApiData;
  months: string[];
  size?: "row" | "large";
  mark?: string;
}
const { api, months, size = "row", mark } = Astro.props;
const cells = monthCells(api, months);
---

<span class:list={["stripes", size]} aria-hidden="true">
  {cells.map((c) => <span class:list={[binOf(c), { mark: c.month === mark }]} data-tip={`${api.name}, ${cellLabel(c)}`} />)}
</span>

<style>
  .stripes {
    display: flex;
    width: 100%;
    height: 1.5rem;
  }

  .large {
    height: clamp(4rem, 12vw, 7rem);
  }

  .stripes > span {
    flex: 1 1 0;
    min-width: 0;
    background: var(--calm);
  }

  .stripes > span:hover {
    outline: 2px solid var(--ink);
    outline-offset: -1px;
    position: relative;
  }

  .before {
    background: transparent !important;
  }

  /* No readable spec: hatched, so it never reads as a calm month. */
  .gap {
    background: repeating-linear-gradient(135deg, var(--rule) 0 2px, transparent 2px 5px) !important;
  }

  .b0 { background: var(--s1) !important; }
  .b1 { background: var(--s2) !important; }
  .b2 { background: var(--s3) !important; }
  .b3 { background: var(--s4) !important; }
  .b4 { background: var(--s5) !important; }

  .mark {
    box-shadow: 0 0 0 2px var(--paper), 0 0 0 3.5px var(--ink);
    position: relative;
    z-index: 1;
  }
</style>
