---
interface Props {
  gap?: boolean;
}
const { gap = true } = Astro.props;
---

<ul class="legend">
  <li><span class="key hard"></span>Breaking change</li>
  <li><span class="key soft"></span>Soft changes only</li>
  <li><span class="key calm"></span>Nothing breaking</li>
  {gap && <li><span class="key gap"></span>No readable spec</li>}
</ul>

<style>
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    color: var(--ink-2);
    font-size: var(--s-1);
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .key {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 2px;
    background: var(--calm);
  }

  .hard {
    background: var(--hard);
  }
  .soft {
    background: var(--soft);
  }
  .gap {
    background: repeating-linear-gradient(135deg, var(--calm) 0 3px, transparent 3px 6px);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
</style>
