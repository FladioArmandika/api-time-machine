---
// Last month's breaking changes: one real example per API, as oasdiff reported it.
import { codeParts, lastFullMonth, lastMonthBreaks, monthLong, plural } from "../lib/data";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rows = lastMonthBreaks();
const total = rows.reduce((n, r) => n + r.count, 0);
const sentence = (t: string) => (t.charAt(0).toUpperCase() + t.slice(1)).replace(/^Api /, "API ");
---

<section class="feed" aria-labelledby="feed-title">
  <div class="intro">
    <h2 id="feed-title">What broke in {monthLong(lastFullMonth)}</h2>
    <p>
      {plural(total, "breaking change")} across {rows.length} APIs. One example from each, with the endpoint it hit.
    </p>
  </div>
  <ol>
    {
      rows.map(({ api, count, change }) => (
        <li>
          <a class="who" href={`${base}/api/${api.id}/`}>
            <span class="name">{api.name}</span>
            <span class="count num">{count.toLocaleString("en-US")}</span>
          </a>
          <div class="what">
            <code class="op">{change.operations[0]}</code>
            <p>{codeParts(sentence(change.text)).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .feed {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 4rem;
  }

  @media (min-width: 60rem) {
    .feed {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
  }

  h2 {
    font-size: var(--t2);
  }

  .intro p {
    margin-top: 0.5rem;
    color: var(--ink-2);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }

  .who {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    color: var(--ink);
    text-decoration: none;
  }

  .who:hover .name {
    text-decoration: underline;
  }

  .name {
    font-weight: 600;
  }

  .count {
    color: var(--red);
    font-weight: 500;
  }

  .what {
    display: grid;
    gap: 0.2rem;
  }

  .op {
    font-size: 0.8125rem;
    color: var(--ink);
  }

  .what p {
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  .what p code {
    font-size: 0.8125rem;
    color: var(--ink);
  }

  @media (max-width: 40rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
