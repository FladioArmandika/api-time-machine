---
// Score + its weather label, with a small drawn icon instead of emoji so it renders the same everywhere.
import type { Score } from "../lib/data";

interface Props {
  score: Score;
  size?: "small" | "large";
}
const { score, size = "small" } = Astro.props;
const kind = score.label.toLowerCase();
---

<span class:list={["weather", size, kind]}>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    {kind === "clear" && (
      <g class="sun">
        <circle cx="12" cy="12" r="4.5" />
        <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
      </g>
    )}
    {kind === "fair" && (
      <g>
        <g class="sun"><circle cx="9" cy="9" r="3.5" /><path d="M9 2.5v1.8M2.5 9h1.8M4.4 4.4l1.3 1.3M13.6 4.4l-1.3 1.3" /></g>
        <path class="cloud" d="M8 19h9.5a3.5 3.5 0 0 0 .3-7 5 5 0 0 0-9.4 1.5A2.8 2.8 0 0 0 8 19z" />
      </g>
    )}
    {kind === "showers" && (
      <g>
        <path class="cloud" d="M6.5 15h11a4 4 0 0 0 .4-8 6 6 0 0 0-11.3 1.7A3.2 3.2 0 0 0 6.5 15z" />
        <path class="rain" d="M8.5 18l-1 2.5M12.5 18l-1 2.5M16.5 18l-1 2.5" />
      </g>
    )}
    {kind === "storms" && (
      <g>
        <path class="cloud" d="M6.5 14h11a4 4 0 0 0 .4-8 6 6 0 0 0-11.3 1.7A3.2 3.2 0 0 0 6.5 14z" />
        <path class="bolt" d="M12.5 14.5l-2.5 4h3l-2 4" />
      </g>
    )}
  </svg>
  <span class="value num">{score.value}</span>
  <span class="label">{score.label}</span>
</span>

<style>
  .weather {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  svg {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sun circle {
    fill: var(--score-clear);
  }
  .sun path {
    stroke: var(--score-clear);
  }
  .cloud {
    fill: var(--score-fair);
  }
  .showers .cloud {
    fill: var(--score-showers);
  }
  .storms .cloud {
    fill: var(--score-storms);
  }
  .rain {
    stroke: var(--score-showers);
  }
  .bolt {
    stroke: var(--score-storms);
    stroke-width: 2;
  }

  .value {
    font-family: var(--display);
    font-weight: 800;
    min-width: 2ch;
    text-align: right;
  }

  .label {
    color: var(--ink-2);
  }

  .large svg {
    width: 3.5rem;
    height: 3.5rem;
  }

  .large .value {
    font-size: var(--s5);
    line-height: 1;
  }

  .large .label {
    font-size: var(--s2);
  }
</style>
