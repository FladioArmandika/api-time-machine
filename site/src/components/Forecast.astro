---
// The 12-month strip: one cell per month, dark when the spec broke, light for soft-only changes.
import { cellLabel, last12Months, monthCells, monthShort, type ApiData } from "../lib/data";

interface Props {
  api: ApiData;
  size?: "large" | "small";
  months?: string[];
}
const { api, size = "small", months = last12Months } = Astro.props;
const cells = monthCells(api, months);
const breaking = cells.filter((c) => c.state === "hard").length;
const summary = `${api.name}, last ${months.length} months: breaking changes in ${breaking}. ` + cells.map(cellLabel).join("; ");
---

<figure class:list={["forecast", size]} aria-label={summary}>
  <ol class="cells" aria-hidden="true">
    {cells.map((c) => <li class:list={[c.state, { partial: c.partial }]} data-tip={cellLabel(c)} />)}
  </ol>
  {
    size === "large" && (
      <ol class="months" aria-hidden="true">
        {cells.map((c) => <li>{monthShort(c.month)}</li>)}
      </ol>
    )
  }
</figure>

<style>
  .forecast {
    margin: 0;
    --n: 12;
  }

  .cells,
  .months {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    gap: 2px;
  }

  .cells li {
    background: var(--calm);
    border-radius: 2px;
  }

  .small .cells li {
    height: 1.25rem;
    min-width: 0.6rem;
  }

  .large .cells {
    gap: 4px;
  }

  .large .cells li {
    height: clamp(2.5rem, 7vw, 4.5rem);
    border-radius: 4px;
  }

  .cells .hard {
    background: var(--hard);
  }

  .cells .soft {
    background: var(--soft);
  }

  /* No readable spec: hatched, so it never reads as a calm month. */
  .cells .gap {
    background: repeating-linear-gradient(135deg, var(--calm) 0 3px, transparent 3px 6px);
  }

  .cells .before {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .months {
    gap: 4px;
    margin-top: 0.4rem;
    color: var(--ink-3);
    font-size: var(--s-1);
  }

  .months li {
    text-align: center;
  }

  @media (max-width: 34rem) {
    .months li:nth-child(even) {
      visibility: hidden;
    }
  }
</style>
