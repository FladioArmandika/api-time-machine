---
import { REPO_URL, updatedOn } from "../lib/data";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>API Weather</a>
      <nav aria-label="Site">
        <a href={`${base}/#ranking`}>Ranking</a>
        <a href={`${base}/methodology/`} aria-current={path.startsWith("/methodology") ? "page" : undefined}>Methodology</a>
        <a href={REPO_URL}>Source</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
      <p>
        Data refreshed daily from each vendor's published OpenAPI spec and diffed with
        <a href="https://github.com/oasdiff/oasdiff">oasdiff</a>. Last updated {updatedOn}.
      </p>
      <p>A side project by <a href="https://github.com/FladioArmandika">Fladio Armandika</a>.</p>
      </div>
    </footer>
    <div class="tip" role="tooltip" hidden></div>
    <script>
      // One shared tooltip for every element with data-tip (forecast cells, chart columns).
      const tip = document.querySelector<HTMLElement>(".tip")!;
      const show = (el: HTMLElement, x: number, y: number) => {
        tip.textContent = el.dataset.tip ?? "";
        tip.hidden = false;
        const w = tip.offsetWidth;
        const left = Math.min(Math.max(8, x - w / 2), window.innerWidth - w - 8);
        tip.style.left = `${left}px`;
        tip.style.top = `${y - tip.offsetHeight - 12}px`;
      };
      document.addEventListener("pointerover", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-tip]");
        if (!el) return;
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.top);
      });
      document.addEventListener("pointerout", (e) => {
        if ((e.target as HTMLElement).closest("[data-tip]")) tip.hidden = true;
      });
      document.addEventListener("focusin", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-tip]");
        if (!el) return;
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.top);
      });
      document.addEventListener("focusout", () => (tip.hidden = true));
      window.addEventListener("scroll", () => (tip.hidden = true), { passive: true });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --wash: #f4f5f7;
    --ink: #1b1f24;
    --ink-2: #4b525b;
    --ink-3: #6e7681;
    --rule: #e1e4e8;
    /* Diff vocabulary: red is a breaking change, grey a soft one. Nothing else gets colour. */
    --red: #cf222e;
    --red-wash: #ffebe9;
    --red-line: #ffcecb;
    --soft: #b9bfc7;
    --link: #1b1f24;
    --focus: #cf222e;

    --sans: "Schibsted Grotesk", "Helvetica Neue", Arial, sans-serif;
    --mono: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;

    --t-1: 0.8125rem;
    --t0: 1rem;
    --t1: 1.1875rem;
    --t2: 1.5rem;
    --t3: 2rem;
    --t4: 2.75rem;
    --t5: 4rem;

    --measure: 64ch;
    --page: 74rem;
    --gutter: clamp(1rem, 4vw, 2.5rem);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #101216;
      --wash: #171a1f;
      --ink: #e8eaed;
      --ink-2: #aeb4bc;
      --ink-3: #858c96;
      --rule: #272b32;
      --red: #ff7b72;
      --red-wash: #2a1517;
      --red-line: #5c2427;
      --soft: #4d545e;
      --link: #e8eaed;
      --focus: #ff7b72;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    background: var(--bg);
  }

  body {
    margin: 0;
    color: var(--ink);
    font: 400 1.0625rem / 1.55 var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }

  p {
    margin: 0;
    max-width: var(--measure);
  }

  a {
    color: var(--link);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--ink-3);
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  :focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  code {
    font-family: var(--mono);
    font-size: 0.86em;
    overflow-wrap: anywhere;
  }

  .skip {
    position: absolute;
    left: -999px;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    background: var(--bg);
    padding: 0.5rem 1rem;
    z-index: 10;
  }

  .site-header,
  main,
  .site-footer {
    max-width: var(--page);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 1.25rem;
  }

  .brand {
    font-weight: 800;
    font-size: var(--t1);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  .site-header nav {
    display: flex;
    gap: 1.5rem;
  }

  .site-header nav a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-header nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
  }

  .site-footer {
    margin-top: 6rem;
    padding-bottom: 3rem;
    color: var(--ink-3);
    font-size: var(--t-1);
  }

  .site-footer > div {
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
    display: grid;
    gap: 0.4rem;
  }

  .site-footer a {
    color: inherit;
  }

  .tip {
    position: fixed;
    z-index: 20;
    pointer-events: none;
    max-width: 18rem;
    padding: 0.35rem 0.55rem;
    border-radius: 4px;
    background: var(--ink);
    color: var(--bg);
    font-size: var(--t-1);
    line-height: 1.4;
  }

  /* Schibsted's tabular figures space out commas, so numbers keep proportional figures. */
  .num {
    font-variant-numeric: lining-nums;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
