---
import { REPO_URL, updatedOn } from "../lib/data";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>API Weather</a>
      <nav aria-label="Site">
        <a href={`${base}/#ranking`}>Ranking</a>
        <a href={`${base}/methodology/`} aria-current={path.startsWith("/methodology") ? "page" : undefined}>Methodology</a>
        <a href={REPO_URL}>GitHub</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
      <p>
        Data refreshed daily from each vendor's published OpenAPI spec and diffed with
        <a href="https://github.com/oasdiff/oasdiff">oasdiff</a>. Last updated {updatedOn}.
      </p>
      <p>A side project by <a href="https://github.com/FladioArmandika">Fladio Armandika</a>.</p>
      </div>
    </footer>
    <div class="tip" role="tooltip"></div>
    <script>
      // One shared tooltip for every element with data-tip. It follows the pointer along a chart and fades between values.
      const tip = document.querySelector<HTMLElement>(".tip")!;
      let current: HTMLElement | null = null;
      const place = (x: number, top: number) => {
        const w = tip.offsetWidth;
        const left = Math.min(Math.max(8, x - w / 2), window.innerWidth - w - 8);
        tip.style.transform = `translate(${left}px, ${top - tip.offsetHeight - 10}px)`;
      };
      const show = (el: HTMLElement, x: number) => {
        current = el;
        tip.textContent = el.dataset.tip ?? "";
        place(x, el.getBoundingClientRect().top);
        tip.classList.add("on");
      };
      const hide = () => {
        current = null;
        tip.classList.remove("on");
      };
      document.addEventListener("pointerover", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-tip]");
        if (el) show(el, e.clientX);
      });
      document.addEventListener("pointermove", (e) => {
        if (current) place(e.clientX, current.getBoundingClientRect().top);
      });
      document.addEventListener("pointerout", (e) => {
        const to = (e.relatedTarget as HTMLElement | null)?.closest?.("[data-tip]");
        if (!to) hide();
      });
      document.addEventListener("focusin", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-tip]");
        if (el) {
          const r = el.getBoundingClientRect();
          show(el, r.left + r.width / 2);
        }
      });
      document.addEventListener("focusout", hide);
      window.addEventListener("scroll", hide, { passive: true });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --wash: #f4f5f7;
    --ink: #1b1f24;
    --ink-2: #4b525b;
    --ink-3: #6e7681;
    --rule: #e1e4e8;
    /* Diff vocabulary: red is a breaking change, grey a soft one. Nothing else gets colour. */
    --red: #cf222e;
    --red-wash: #ffebe9;
    --red-line: #ffcecb;
    --soft: #b9bfc7;
    --link: #1b1f24;
    --focus: #cf222e;

    --sans: "Geist", "Helvetica Neue", Arial, sans-serif;
    --mono: "Geist Mono", ui-monospace, Menlo, Consolas, monospace;

    --t-1: 0.8125rem;
    --t0: 0.9375rem;
    --t1: 1.0625rem;
    --t2: 1.3125rem;
    --t3: 1.75rem;
    --t4: 2.5rem;
    --t5: 3.25rem;

    --measure: 62ch;
    --page: 72rem;
    --gutter: clamp(1rem, 4vw, 2.5rem);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #101216;
      --wash: #171a1f;
      --ink: #e8eaed;
      --ink-2: #aeb4bc;
      --ink-3: #858c96;
      --rule: #272b32;
      --red: #ff7b72;
      --red-wash: #2a1517;
      --red-line: #5c2427;
      --soft: #4d545e;
      --link: #e8eaed;
      --focus: #ff7b72;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    background: var(--bg);
  }

  body {
    margin: 0;
    color: var(--ink);
    font: 400 var(--t0) / 1.6 var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  p {
    margin: 0;
    max-width: var(--measure);
  }

  a {
    color: var(--link);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--ink-3);
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  :focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  code {
    font-family: var(--mono);
    font-size: 0.86em;
    overflow-wrap: anywhere;
  }

  .skip {
    position: absolute;
    left: -999px;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    background: var(--bg);
    padding: 0.5rem 1rem;
    z-index: 10;
  }

  .site-header,
  main,
  .site-footer {
    max-width: var(--page);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 1.25rem;
  }

  .brand {
    font-weight: 600;
    font-size: var(--t0);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  .site-header nav {
    display: flex;
    gap: 1.5rem;
    font-size: var(--t0);
  }

  .site-header nav a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-header nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
  }

  .site-footer {
    margin-top: 5rem;
    padding-bottom: 2.5rem;
    color: var(--ink-3);
    font-size: var(--t-1);
  }

  .site-footer > div {
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
    display: grid;
    gap: 0.4rem;
  }

  .site-footer a {
    color: inherit;
  }

  .tip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease-out;
    will-change: transform;
    max-width: 18rem;
    padding: 0.35rem 0.55rem;
    border-radius: 4px;
    background: var(--ink);
    color: var(--bg);
    font-size: var(--t-1);
    line-height: 1.4;
  }

  .tip.on {
    opacity: 1;
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  a {
    transition: text-decoration-color 150ms ease-out, color 150ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
