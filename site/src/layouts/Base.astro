---
import { REPO_URL, updatedOn } from "../lib/data";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Public+Sans:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <rect x="0" width="4" height="20" fill="var(--s1)" /><rect x="4" width="4" height="20" fill="var(--s3)" />
          <rect x="8" width="4" height="20" fill="var(--s5)" /><rect x="12" width="4" height="20" fill="var(--s2)" />
          <rect x="16" width="4" height="20" fill="var(--s4)" />
        </svg>
        <span>API Weather</span>
      </a>
      <nav aria-label="Site">
        <a href={`${base}/#leaderboard`}>All APIs</a>
        <a href={`${base}/methodology/`} aria-current={path.startsWith("/methodology") ? "page" : undefined}>Methodology</a>
        <a href={REPO_URL}>Source</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
      <p>
        Data refreshed daily from each vendor's published OpenAPI spec and diffed with
        <a href="https://github.com/oasdiff/oasdiff">oasdiff</a>. Last updated {updatedOn}.
      </p>
      <p>A side project by <a href="https://github.com/FladioArmandika">Fladio Armandika</a>.</p>
      </div>
    </footer>
    <div class="tip" role="tooltip" hidden></div>
    <script>
      // One shared tooltip for every element with data-tip (forecast cells, chart columns).
      const tip = document.querySelector<HTMLElement>(".tip")!;
      const show = (el: HTMLElement, x: number, y: number) => {
        tip.textContent = el.dataset.tip ?? "";
        tip.hidden = false;
        const w = tip.offsetWidth;
        const left = Math.min(Math.max(8, x - w / 2), window.innerWidth - w - 8);
        tip.style.left = `${left}px`;
        tip.style.top = `${y - tip.offsetHeight - 12}px`;
      };
      document.addEventListener("pointerover", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-tip]");
        if (!el) return;
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.top);
      });
      document.addEventListener("pointerout", (e) => {
        if ((e.target as HTMLElement).closest("[data-tip]")) tip.hidden = true;
      });
      document.addEventListener("focusin", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-tip]");
        if (!el) return;
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.top);
      });
      document.addEventListener("focusout", () => (tip.hidden = true));
      window.addEventListener("scroll", () => (tip.hidden = true), { passive: true });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --paper: #eef1f3;
    --panel: #f7f9fa;
    --ink: #141a24;
    --ink-2: #3f4a56;
    --ink-3: #66717c;
    --rule: #d5dce1;
    /* Month intensity, one hue: soft-only, then 1–4, 5–19, 20–99, 100+ breaking changes. */
    --calm: #dde3e7;
    --s1: #a3a7e6;
    --s2: #7c80d8;
    --s3: #5759c0;
    --s4: #383396;
    --s5: #1b1455;
    --link: #383396;
    --focus: #383396;

    --display: "Bricolage Grotesque", "Avenir Next Condensed", system-ui, sans-serif;
    --text: "Public Sans", system-ui, sans-serif;

    --t-1: 0.8125rem;
    --t0: 1rem;
    --t1: 1.125rem;
    --t2: 1.375rem;
    --t3: 1.875rem;
    --t4: 2.75rem;
    --t5: 4rem;
    --t6: 5.75rem;

    --measure: 66ch;
    --page: 76rem;
    --gutter: clamp(1rem, 4vw, 2.5rem);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #0f1318;
      --panel: #151b22;
      --ink: #e6ebf0;
      --ink-2: #b5bfc9;
      --ink-3: #8a96a2;
      --rule: #252e38;
      --calm: #1d252e;
      --s1: #3b4290;
      --s2: #5157b5;
      --s3: #7378d3;
      --s4: #a0a4eb;
      --s5: #d3d5f9;
      --link: #a0a4eb;
      --focus: #a0a4eb;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    background: var(--paper);
  }

  body {
    margin: 0;
    color: var(--ink);
    font: 400 1.0625rem / 1.6 var(--text);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 700;
    font-variation-settings: "wdth" 80;
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }

  p {
    margin: 0;
    max-width: var(--measure);
  }

  a {
    color: var(--link);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  :focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
    border-radius: 2px;
  }

  code {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.88em;
    background: var(--calm);
    padding: 0.05em 0.3em;
    border-radius: 3px;
    overflow-wrap: anywhere;
  }

  .skip {
    position: absolute;
    left: -999px;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    background: var(--panel);
    padding: 0.5rem 1rem;
    z-index: 10;
  }

  .site-header,
  main,
  .site-footer {
    max-width: var(--page);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--display);
    font-variation-settings: "wdth" 80;
    font-weight: 700;
    font-size: var(--t2);
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .brand svg {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 3px;
  }

  .site-header nav {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9375rem;
  }

  .site-header nav a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-header nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
  }

  .site-footer {
    margin-top: 6rem;
    padding-bottom: 3rem;
    color: var(--ink-3);
    font-size: var(--t-1);
  }

  .site-footer > div {
    border-top: 1px solid var(--rule);
    padding-top: 2rem;
    display: grid;
    gap: 0.5rem;
  }

  .site-footer a {
    color: inherit;
  }

  .tip {
    position: fixed;
    z-index: 20;
    pointer-events: none;
    max-width: 18rem;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--t-1);
    line-height: 1.4;
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
