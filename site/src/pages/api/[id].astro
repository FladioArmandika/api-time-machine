---
import Base from "../../layouts/Base.astro";
import BadgeSnippet from "../../components/BadgeSnippet.astro";
import Timeline from "../../components/Timeline.astro";
import {
  apis, codeParts, leaderboard, monthLong, monthShortYear, plural, rawJsonUrl, ruleName,
  type ApiData, type Change,
} from "../../lib/data";

export function getStaticPaths() {
  return apis.map((api) => ({ params: { id: api.id }, props: { api } }));
}

interface Props {
  api: ApiData;
}
const { api } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rank = leaderboard.find((r) => r.id === api.id)!.rank;
// Neighbours in the ranking, so readers can walk the list without going back to the home page.
const idx = leaderboard.findIndex((r) => r.id === api.id);
const prev = leaderboard[idx - 1];
const next = leaderboard[idx + 1];
const l12 = api.last12;

const lede =
  l12.breakingMonths === 0
    ? `No breaking changes in the last 12 months.`
    : l12.breakingMonths === 12
      ? `A breaking change in every one of the last 12 months.`
      : `Breaking changes in ${l12.breakingMonths} of the last 12 months.`;

// Months with anything to report, newest first. Large months are capped; the full list is in the JSON.
const HARD_CAP = 25;
const SOFT_CAP = 10;
const log = api.intervals.filter((i) => !i.gap && !i.error && i.hard + i.soft > 0).reverse();
const years = Object.entries(api.byYear).sort(([a], [b]) => b.localeCompare(a));
const problems = api.intervals.filter((i) => i.gap || i.error);
const repaired = api.intervals.filter((i) => i.repairedRefs).length;

const hardOf = (cs: Change[]) => cs.filter((c) => c.level === "hard");
const softOf = (cs: Change[]) => cs.filter((c) => c.level === "soft");
---

<Base title={`${api.name}: API Weather`} image={`og/${api.id}.png`} description={`${api.name}: ${lede} Stability score ${api.score.value}/100.`}>
  <article>
    <header class="api-head">
      <p class="crumb"><a href={`${base}/#ranking`}>Ranking</a>: {rank} of {apis.length}</p>
      <h1>{api.name}</h1>
      <p class="lede">{lede}</p>
      <dl class="facts">
        <div><dt>Score</dt><dd class="num">{api.score.value}<span>/100</span></dd></div>
        <div><dt>Breaking, last 12 months</dt><dd class="num red">{l12.hard.toLocaleString("en-US")}</dd></div>
        <div><dt>Soft, last 12 months</dt><dd class="num">{l12.soft.toLocaleString("en-US")}</dd></div>
        <div><dt>Endpoints</dt><dd class="num">{api.operations.toLocaleString("en-US")}</dd></div>
      </dl>
      {api.notes && <p class="note">{api.notes}</p>}
      <nav class="jump" aria-label="On this page">
        <a href="#history">History</a>
        <a href="#years">By year</a>
        <a href="#log">Change log</a>
        <a href="#badge">Badge</a>
        <a href="#source">Source</a>
      </nav>
    </header>

    <section aria-labelledby="history">
      <div class="section-head">
        <h2 id="history">Changes per month since {monthShortYear(api.firstMonth)}</h2>
        <ul class="key">
          <li><span class="sw hard"></span>Breaking</li>
          <li><span class="sw soft"></span>Soft</li>
        </ul>
      </div>
      <Timeline api={api} />
      {
        api.worstMonth && (
          <p class="aside">
            The worst month was {monthLong(api.worstMonth.month)}: {plural(api.worstMonth.hard, "breaking change")} across{" "}
            {plural(api.worstMonth.hardOperations, "endpoint")}.
          </p>
        )
      }
    </section>

    <section aria-labelledby="years">
      <h2 id="years">By year</h2>
      <div class="table-wrap">
        <table class="years">
          <thead>
            <tr>
              <th scope="col">Year</th>
              <th scope="col" class="n">Breaking</th>
              <th scope="col" class="n">Soft</th>
              <th scope="col" class="n">Months broken</th>
            </tr>
          </thead>
          <tbody>
            {
              years.map(([y, v]) => (
                <tr>
                  <th scope="row" class="num">{y}</th>
                  <td class="n num">{v.hard.toLocaleString("en-US")}</td>
                  <td class="n num">{v.soft.toLocaleString("en-US")}</td>
                  <td class="n num">{v.breakingMonths} of {v.changedMonths}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="log">
      <div class="section-head">
        <h2 id="log">Change log</h2>
        <button type="button" class="toggle-all" data-open="false">Expand all</button>
      </div>
      <p class="intro">What oasdiff flagged, month by month. One change can touch many endpoints; the count says how many.</p>
      <div class="log">
        {
          log.map((i, idx) => {
            const hard = hardOf(i.changes);
            const soft = softOf(i.changes);
            return (
              <details open={idx === 0}>
                <summary>
                  <span class="m">{monthLong(i.to)}{i.partial ? " so far" : ""}</span>
                  <span class="counts num">
                    {i.hard > 0 && <span class="c-hard">{i.hard.toLocaleString("en-US")} breaking</span>}
                    {i.soft > 0 && <span class="c-soft">{i.soft.toLocaleString("en-US")} soft</span>}
                  </span>
                </summary>
                {hard.length > 0 && (
                  <ul class="changes">
                    {hard.slice(0, HARD_CAP).map((c) => (
                      <li>
                        {c.operations.length > 0 && (
                          <p class="op">
                            <code>{c.operations[0]}</code>
                            {c.operationCount > 1 && <span> and {plural(c.operationCount - 1, "more endpoint")}</span>}
                          </p>
                        )}
                        <p class="what">{codeParts(c.text).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</p>
                        {c.enumValueCount && c.enumValueCount > 1 && (
                          <p class="meta">
                            {plural(c.enumValueCount, "value")}: {c.enumValues!.join(", ")}
                            {c.enumValueCount > c.enumValues!.length ? ", and more" : ""}
                          </p>
                        )}
                        <p class="meta">{ruleName(c.id)}</p>
                      </li>
                    ))}
                  </ul>
                )}
                {hard.length > HARD_CAP && (
                  <p class="more">
                    {plural(hard.length - HARD_CAP, "more breaking change")} this month, in the <a href={rawJsonUrl(api)}>raw data</a>.
                  </p>
                )}
                {soft.length > 0 && (
                  <details class="soft-list">
                    <summary>Soft changes ({soft.length.toLocaleString("en-US")})</summary>
                    <ul class="changes soft">
                      {soft.slice(0, SOFT_CAP).map((c) => (
                        <li>
                          <p class="what">{codeParts(c.text).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</p>
                        </li>
                      ))}
                    </ul>
                    {soft.length > SOFT_CAP && (
                      <p class="more">
                        {plural(soft.length - SOFT_CAP, "more")} in the <a href={rawJsonUrl(api)}>raw data</a>.
                      </p>
                    )}
                  </details>
                )}
              </details>
            );
          })
        }
      </div>
    </section>

    <section aria-labelledby="badge">
      <h2 id="badge">Badge</h2>
      <p class="intro">Show this API's score in your README. It updates with the data every day.</p>
      <BadgeSnippet api={api} />
    </section>

    <section aria-labelledby="source">
      <h2 id="source">Source</h2>
      <p>
        Spec: <a href={api.sourceUrl}><code>{api.repo}/{api.path}</code></a>, OpenAPI {api.openapi}. Raw numbers for this page:{" "}
        <a href={rawJsonUrl(api)}><code>data/apis/{api.id}.json</code></a>.
      </p>
      {
        (problems.length > 0 || repaired > 0) && (
          <p class="aside">
            {problems.length > 0 && `${plural(problems.length, "month")} couldn't be compared and ${problems.length === 1 ? "is" : "are"} shown as hatched. `}
            {repaired > 0 && `${plural(repaired, "month")} needed broken references in the spec repaired before comparing. `}
            <a href={`${base}/methodology/`}>Why</a>.
          </p>
        )
      }
    </section>

    <nav class="pager" aria-label="Other APIs">
      {
        prev ? (
          <a class="prev" href={`${base}/api/${prev.id}/`}>
            <span>Previous: #{prev.rank}</span>
            <strong>{prev.name} <span class="num">{prev.score.value}/100</span></strong>
          </a>
        ) : <span />
      }
      {
        next && (
          <a class="next" href={`${base}/api/${next.id}/`}>
            <span>Next: #{next.rank}</span>
            <strong>{next.name} <span class="num">{next.score.value}/100</span></strong>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<script>
  // One button opens or closes every month of the change log.
  const btn = document.querySelector<HTMLButtonElement>(".toggle-all");
  const months = document.querySelectorAll<HTMLDetailsElement>(".log details");
  btn?.addEventListener("click", () => {
    const open = btn.dataset.open !== "true";
    for (const d of months) d.open = open;
    btn.dataset.open = String(open);
    btn.textContent = open ? "Collapse all" : "Expand all";
  });
</script>

<style>
  article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4rem;
  }

  .api-head {
    padding-top: clamp(1.5rem, 5vw, 3.5rem);
    display: grid;
    gap: 1rem;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 0.5rem;
    font-size: var(--t-1);
  }

  .jump a {
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .jump a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .toggle-all {
    font: inherit;
    font-size: var(--t-1);
    color: var(--ink-2);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
  }

  .toggle-all:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 160ms ease-out, background-color 160ms ease-out;
  }

  .pager a:hover {
    border-color: var(--ink-3);
    background: var(--wash);
  }

  .pager a > span:first-child {
    font-size: var(--t-1);
    font-weight: 400;
    color: var(--ink-3);
  }

  .pager strong {
    font-weight: 600;
  }

  .pager a .num {
    font-weight: 400;
    color: var(--ink-3);
  }

  .pager .next {
    text-align: right;
    grid-column: 2;
  }

  .crumb {
    color: var(--ink-3);
    font-size: var(--t-1);
  }

  .crumb a {
    color: var(--ink-2);
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, var(--t5));
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .lede {
    font-size: var(--t2);
    line-height: 1.4;
    color: var(--ink-2);
    letter-spacing: -0.01em;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem 2rem;
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .facts dt {
    color: var(--ink-3);
    font-size: var(--t-1);
  }

  .facts dd {
    margin: 0;
    font-weight: 600;
    font-size: var(--t3);
    letter-spacing: -0.03em;
  }

  .facts dd span {
    font-size: var(--t0);
    font-weight: 400;
    color: var(--ink-3);
  }

  .red {
    color: var(--red);
  }

  .note {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  h2 {
    font-size: var(--t2);
  }

  section > h2 {
    margin-bottom: 1rem;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
    font-size: var(--t-1);
    color: var(--ink-2);
  }

  .key li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sw {
    width: 0.7rem;
    height: 0.7rem;
  }

  .sw.hard {
    background: var(--red);
  }

  .sw.soft {
    background: var(--soft);
  }

  .aside,
  .intro {
    margin-top: 0.75rem;
    color: var(--ink-2);
  }

  .intro {
    margin: -0.25rem 0 1.25rem;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table.years {
    width: 100%;
    max-width: 44rem;
    border-collapse: collapse;
    min-width: 0;
  }

  .years th,
  .years td {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
  }

  .years thead th {
    font-weight: 400;
    font-size: var(--t-1);
    color: var(--ink-3);
    border-bottom-color: var(--ink);
  }

  .years tbody th {
    font-weight: 600;
  }

  .n {
    text-align: right !important;
  }

  .log {
    display: grid;
    max-width: 52rem;
    border-top: 1px solid var(--ink);
  }

  .log > details {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    cursor: pointer;
    list-style: none;
    padding-block: 0.8rem;
    display: grid;
    grid-template-columns: auto minmax(11rem, auto) 1fr;
    gap: 0.25rem 1rem;
    align-items: baseline;
  }

  .soft-list summary {
    display: flex;
  }

  @media (max-width: 40rem) {
    summary {
      grid-template-columns: auto 1fr;
    }

    summary .counts {
      grid-column: 2;
    }
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* A plus that turns into a minus as the month opens. */
  .log > details > summary::before,
  .soft-list > summary::before {
    content: "";
    width: 0.6rem;
    height: 0.6rem;
    align-self: center;
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1.5px 100% no-repeat;
    color: var(--ink-3);
    transition: transform 200ms ease-out;
  }

  details[open] > summary::before {
    transform: rotate(90deg);
    background: linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat;
  }

  summary:hover .m {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Opening a month eases its height where the browser supports animating to auto. */
  @supports (interpolate-size: allow-keywords) {
    .log {
      interpolate-size: allow-keywords;
    }

    details::details-content {
      height: 0;
      overflow: clip;
      transition: height 260ms ease-out, content-visibility 260ms allow-discrete;
    }

    details[open]::details-content {
      height: auto;
    }
  }

  .m {
    font-weight: 600;
    min-width: 11rem;
  }

  .counts {
    display: flex;
    gap: 1rem;
    font-size: 0.9375rem;
  }

  .c-hard {
    color: var(--red);
  }

  .c-soft {
    color: var(--ink-3);
  }

  .changes {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  /* A thin red rule marks each breaking change; soft ones get a grey one. */
  .changes li {
    padding: 0.5rem 0 0.55rem 1rem;
    border-left: 2px solid var(--red);
    display: grid;
    gap: 0.1rem;
  }

  .changes li + li {
    margin-top: 0.5rem;
  }

  .changes.soft li {
    border-left-color: var(--soft);
  }

  .op {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .op code {
    color: var(--ink);
  }

  .what {
    font-size: 0.9375rem;
  }

  .what code,
  .op code {
    font-size: 0.8125rem;
  }

  .meta,
  .more {
    font-size: var(--t-1);
    color: var(--ink-3);
  }

  .more {
    margin-bottom: 1rem;
  }

  .soft-list {
    margin-bottom: 1rem;
  }

  .soft-list summary {
    font-size: 0.9375rem;
    color: var(--ink-2);
    padding-block: 0.4rem;
  }
</style>
