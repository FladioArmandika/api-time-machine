---
import Base from "../layouts/Base.astro";
import Forecast from "../components/Forecast.astro";
import Legend from "../components/Legend.astro";
import Weather from "../components/Weather.astro";
import { apiById, apis, headlines, last12Months, leaderboard, monthLong, plural, updatedOn } from "../lib/data";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const [lead, ...rest] = headlines;
const leadApi = lead?.apiId ? apiById(lead.apiId) : undefined;
const first = last12Months[0];
const last = last12Months.at(-1)!;
---

<Base
  title="API Weather: how often popular APIs break their clients"
  description={lead?.text ?? "Stability scores for popular public APIs, from the git history of their OpenAPI specs."}
>
  <section class="hero" aria-labelledby="lead">
    <p class="dateline">Weather report for {apis.length} public APIs, updated {updatedOn}</p>
    <h1 id="lead">{lead?.text}</h1>
    {
      leadApi && (
        <div class="lead-strip">
          <Forecast api={leadApi} size="large" />
          <div class="lead-foot">
            <Legend gap={false} />
            <a href={`${base}/api/${leadApi.id}/`}>{leadApi.name}'s full history</a>
          </div>
        </div>
      )
    }
  </section>

  <section class="findings" aria-labelledby="findings-title">
    <h2 id="findings-title">Also in the data</h2>
    <ul>
      {
        rest.map((h) => (
          <li>
            {h.apiId ? <a href={`${base}/api/${h.apiId}/`}>{h.text}</a> : h.text}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="board" id="leaderboard" aria-labelledby="board-title">
    <div class="board-head">
      <h2 id="board-title">Leaderboard</h2>
      <p>
        Ranked by stability score: 100 means no breaking changes in the past year, lower means more and more recent ones,
        adjusted for how big the API is. The strip shows {monthLong(first)} to {monthLong(last)}.
        <a href={`${base}/methodology/`}>How the score works</a>.
      </p>
      <Legend />
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col" class="rank"><span class="sr">Rank</span></th>
            <th scope="col">API</th>
            <th scope="col">Score</th>
            <th scope="col" class="strip-col">Last 12 months</th>
            <th scope="col" class="n">Breaking</th>
            <th scope="col" class="n">Soft</th>
            <th scope="col" class="n hide-s">Endpoints</th>
          </tr>
        </thead>
        <tbody>
          {
            leaderboard.map((row) => (
              <tr>
                <td class="rank num">{row.rank}</td>
                <th scope="row">
                  <a href={`${base}/api/${row.id}/`}>{row.name}</a>
                </th>
                <td>
                  <Weather score={row.score} />
                </td>
                <td class="strip-col">
                  <Forecast api={apiById(row.id)} />
                  <span class="sr">Breaking changes in {plural(row.last12.breakingMonths, "month")} of 12.</span>
                </td>
                <td class="n num">{row.last12.hard.toLocaleString("en-US")}</td>
                <td class="n num">{row.last12.soft.toLocaleString("en-US")}</td>
                <td class="n num hide-s">{row.operations.toLocaleString("en-US")}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="fine">
      Breaking and soft counts cover the last 12 months. A change reported on many endpoints counts once. Endpoints is the
      current number of operations in the spec.
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 8vw, 6rem) 3.5rem;
    display: grid;
    gap: 1.5rem;
  }

  .dateline {
    color: var(--ink-2);
  }

  .hero h1 {
    font-size: clamp(2.25rem, 6.2vw, var(--s6));
    max-width: 18ch;
    font-variation-settings: "opsz" 96;
  }

  .lead-strip {
    margin-top: 1.5rem;
    max-width: 52rem;
  }

  .lead-foot {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    align-items: baseline;
  }

  .findings {
    padding-block: 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .findings h2,
  .board h2 {
    font-size: var(--s3);
    margin-bottom: 1.25rem;
  }

  .findings ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .findings li {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--s2);
    line-height: 1.3;
    padding-left: 1.25rem;
    border-left: 3px solid var(--soft);
  }

  .findings a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  .findings a:hover {
    text-decoration-color: currentColor;
  }

  .board {
    padding-block: 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .board-head {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .board-head p {
    color: var(--ink-2);
  }

  .table-wrap {
    overflow-x: auto;
    background: var(--surface);
    border-radius: 10px;
    padding: 0.5rem 1rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 40rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: middle;
  }

  tbody tr:last-child > * {
    border-bottom: 0;
  }

  thead th {
    font-weight: 600;
    font-size: var(--s-1);
    color: var(--ink-3);
  }

  tbody th {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--s1);
  }

  tbody th a {
    color: var(--ink);
    text-decoration: none;
  }

  tbody th a:hover {
    text-decoration: underline;
  }

  .rank {
    width: 2rem;
    color: var(--ink-3);
  }

  .strip-col {
    width: 34%;
    min-width: 12rem;
  }

  .n {
    text-align: right;
  }

  .fine {
    margin-top: 1rem;
    color: var(--ink-3);
    font-size: var(--s-1);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 40rem) {
    .hide-s {
      display: none;
    }
  }
</style>
