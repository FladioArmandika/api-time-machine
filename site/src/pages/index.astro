---
import Base from "../layouts/Base.astro";
import Feed from "../components/Feed.astro";
import HeroChart from "../components/HeroChart.astro";
import HistoryChart from "../components/HistoryChart.astro";
import { REPO_URL, allMonths, apis, heroSeries, leadSentence, monthLong, monthShortYear, updatedOn } from "../lib/data";

const lead = leadSentence();
const hero = heroSeries();
---

<Base title="API Weather: how often popular APIs break their clients" description={`${lead.first} ${lead.second}`}>
  <header class="intro">
    <h1>{apis.length} popular APIs shipped <span class="num" data-count={hero.last12}>{hero.last12.toLocaleString("en-US")}</span> breaking changes in the past year.</h1>
    <p class="standfirst">
      {monthLong(hero.peak.m)} was the worst month since all {apis.length} published a spec, with {hero.peak.total}. Over the
      past year, {lead.first} {lead.second}
    </p>
  </header>

  <section class="hero" aria-label="Breaking changes per month, all APIs">
    <HeroChart />
  </section>

  <section class="defs" aria-labelledby="defs-title">
    <h2 id="defs-title">What counts as breaking</h2>
    <p class="defs-lead">A change that can make working client code fail. Three kinds make up almost all of them:</p>
    <dl>
      <div>
        <dt>Something is removed</dt>
        <dd>An endpoint, a response field or an accepted value disappears, and code that used it gets an error.</dd>
      </div>
      <div>
        <dt>Something changes shape</dt>
        <dd>A field's type changes, say from <code>string</code> to <code>object</code>, and parsing code no longer fits.</dd>
      </div>
      <div>
        <dt>Something gets stricter</dt>
        <dd>A parameter becomes required, or a field that was always there can now be missing or <code>null</code>.</dd>
      </div>
    </dl>
    <p class="defs-foot">
      Additions, like a new enum value, are counted as soft changes and kept out of the totals above.
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/methodology/`}>Full methodology</a>
    </p>
  </section>

  <section id="ranking" class="ranking" aria-labelledby="ranking-title">
    <header class="sec-head">
      <h2 id="ranking-title">Who's breaking things</h2>
      <p>
        Each API's full record since {monthShortYear(allMonths[0])}, ranked by stability score. This site diffs each vendor's
        public OpenAPI spec every day and counts the changes that would break existing code. Updated {updatedOn};{" "}
        <a href={REPO_URL}>data and code on GitHub</a>.
      </p>
    </header>
    <HistoryChart />
  </section>

  <Feed />
</Base>

<style>
  .intro {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.75rem, 3vw, 2.5rem);
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }

  h1 {
    font-size: clamp(2rem, 4.4vw, var(--t5));
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .standfirst {
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 40rem;
  }

  .hero {
    margin-bottom: 5.5rem;
  }

  .ranking {
    margin-bottom: 5.5rem;
  }

  .defs {
    margin-bottom: 5.5rem;
    display: grid;
    gap: 0.75rem;
  }

  .defs h2 {
    font-size: var(--t2);
  }

  .defs-lead,
  .defs-foot {
    color: var(--ink-2);
  }

  .defs-foot {
    font-size: var(--t-1);
    color: var(--ink-3);
  }

  .defs-foot a {
    color: inherit;
  }

  dl {
    margin: 0.75rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem 2.5rem;
  }

  dl div {
    border-top: 2px solid var(--red);
    padding-top: 0.75rem;
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0.25rem 0 0;
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  .sec-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .sec-head h2 {
    font-size: var(--t3);
    letter-spacing: -0.03em;
  }

  .sec-head p {
    color: var(--ink-2);
    max-width: 40rem;
  }
</style>
