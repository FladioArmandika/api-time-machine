---
import Base from "../layouts/Base.astro";
import Feed from "../components/Feed.astro";
import HistoryChart from "../components/HistoryChart.astro";
import { REPO_URL, apis, leadSentence, updatedOn } from "../lib/data";

const lead = leadSentence();
---

<Base title="API Weather: how often popular APIs break their clients" description={`${lead.first} ${lead.second}`}>
  <header class="intro">
    <h1>How often do popular APIs break their clients?</h1>
    <p class="standfirst">
      This site diffs the public OpenAPI specs of {apis.length} APIs every day and counts the changes that would break existing
      code. Over the past year, {lead.first} {lead.second}
    </p>
    <p class="meta">Updated {updatedOn}. <a href={REPO_URL}>Data and code on GitHub</a>.</p>
  </header>

  <section id="ranking" class="main-chart" aria-label="Ranking and history">
    <HistoryChart />
  </section>

  <Feed />
</Base>

<style>
  .intro {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2rem, 4vw, 2.75rem);
    display: grid;
    gap: 1rem;
    max-width: 42rem;
  }

  h1 {
    font-size: clamp(2rem, 4.4vw, var(--t5));
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .standfirst {
    font-size: 1.1875rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink-2);
  }

  .meta {
    font-size: var(--t-1);
    color: var(--ink-3);
  }

  .meta a {
    color: inherit;
  }

  .main-chart {
    margin-bottom: 5rem;
  }
</style>
